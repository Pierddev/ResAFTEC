	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"start:dev": "nodemon --watch src --ext ts,json --ignore src/openapi.json --exec tsx src/app.ts",
		"build:dev": "tsc --watch --preserveWatchOutput",
		"dev": "concurrently \"npm:build:dev\" \"npm:start:dev\"",
		"typeorm": "typeorm-ts-node-esm",
		"migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts src/migrations/Migration",
		"migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
		"migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
		"seed": "tsx src/database/seeds/seeders.ts",
		"seed:dev": "tsx src/database/seeds/seeders-dev.ts"
	},
